# HTML: always revalidate with the server, never serve a stale copy from the
# browser cache. This is already Netlify's effective default when no custom
# headers exist, but pinning it explicitly here means it stays correct even
# if that default ever changes.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Static assets: cache for an hour instead of revalidating on every load,
# then must-revalidate. Deliberately NOT a long/immutable cache (e.g. one
# year) -- none of these filenames are content-hashed (main.css stays
# main.css across every deploy), so a long immutable cache would just move
# today's "stale index.html" bug onto CSS/JS/images instead of fixing it.
/*.css
  Cache-Control: public, max-age=3600, must-revalidate

/*.js
  Cache-Control: public, max-age=3600, must-revalidate

/*.jpg
  Cache-Control: public, max-age=3600, must-revalidate

/*.jpeg
  Cache-Control: public, max-age=3600, must-revalidate

/*.png
  Cache-Control: public, max-age=3600, must-revalidate

/*.svg
  Cache-Control: public, max-age=3600, must-revalidate
